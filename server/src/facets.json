  "cost": { "_doc": "sum of maxNumParticles over emitting nodes + node count. high when particles >= highParticles OR nodes >= highNodes; medium when particles >= mediumParticles OR nodes >= mediumNodes; else low.", "mediumParticles": 2500, "highParticles": 5000, "mediumNodes": 5, "highNodes": 8 },
  "motion": { "minSpeed": 0.05, "minGravity": 0.05, "radialConeAngle": 30, "verticalDirection": 0.7 }
 },
